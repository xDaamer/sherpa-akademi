# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase — HEPSİ SUNUCU TARAFI. Hiçbiri VITE_ öneki almaz, yani hiçbiri
# tarayıcı bundle'ına girmez. Frontend Supabase'e doğrudan gitmiyor; her şey
# /api/* üzerinden geçiyor (bkz. server/supabase.ts).
SUPABASE_URL=

# anon/publishable anahtar. ESKİDEN VITE_SUPABASE_ANON_KEY İDİ ve tarayıcıya
# gönderiliyordu. Artık yalnızca burada: kimlik doğrulama çağrıları
# (giriş/kayıt/yenileme) ve kullanıcının kendi jetonuyla yapılan okumalar
# bu anahtarla kuruluyor.
SUPABASE_ANON_KEY=

# RLS'i baypas eder — asla VITE_ öneki almaz, asla istemciye sızmamalı.
# Yalnızca kullanıcıya ait olmayan işler için: lead kaydı, yayınlanmış
# yorumlar, hız limiti sayacı, girişte telefon -> e-posta çevirisi.
SUPABASE_SERVICE_ROLE_KEY=

# İSTEK ATMASINA İZİN VERİLEN TARAYICI ORIGIN'LERİ (virgülle ayrılır).
#
# TAMAMEN BOŞ BIRAKMAK GEÇERLİDİR ve canlıdaki mevcut durum budur: değişken
# tanımsızsa requireTrustedOrigin isteğin KENDİ host'una düşer. Her host kendi
# /api'sini çağırdığı için bu doğru cevaptır ve yabancı bir origin yine 403
# alır — yani CSRF koruması kaybolmaz (ölçüldü).
#
# TEHLİKELİ OLAN "TANIMLI AMA EKSİK" HÂLİ. Site İKİ HOST'TAN servis ediliyor;
# liste verilecekse üçü de olmalı (apex, www, panel). Eksik kalan origin 403
# alır ("Geçersiz istek kaynağı"). Ya hiç yazmayın, ya üçünü birden.
#
# Dev'de bunun bedeli daha ağır: Express orada Vite'ın modül scriptlerini de
# servis ettiği için eksik origin sadece API'yi değil, sayfayı da boş bırakır.
# Yerelde yazacaksanız http://localhost:3000 eklemeyi unutmayın.
#
# Not: bu liste tek başına CSRF koruması DEĞİL — bkz. server/security.ts.
ALLOWED_ORIGINS=https://www.sherpakademi.com,https://sherpakademi.com,https://portal.sherpakademi.com

# OTURUM ÇEREZİNİN ALAN ADI.
# Boş bırakılabilir: sunucu isteğin host'undan türetiyor (*.sherpakademi.com ise
# ".sherpakademi.com", localhost/önizleme ise host'a özel). Yalnızca bu türetmeyi
# ezmek gerektiğinde doldurun — örneğin /etc/hosts'a sherpakademi.local ve
# portal.sherpakademi.local ekleyip iki host'lu kurulumu yerelde denerken:
#   COOKIE_DOMAIN=.sherpakademi.local
# YANLIŞ DEĞER OTURUMU TAMAMEN BOZAR: isteğin host'unu kapsamayan bir Domain
# taşıyan çerezi tarayıcı sessizce atar. Bkz. server/cookies.ts.
COOKIE_DOMAIN=

# İSTEMCİ TARAFI ADRES EZMELERİ (yalnızca geliştirme/önizleme).
# Boşsa need.json'daki canlı adresler kullanılır. Yukarıdaki .local kurulumunda:
#   VITE_MAIN_ORIGIN=http://sherpakademi.local:3000
#   VITE_PORTAL_ORIGIN=http://portal.sherpakademi.local:3000
# Bunlar SIR DEĞİL (yalnızca alan adı), o yüzden VITE_ öneki sorun değil.
VITE_MAIN_ORIGIN=
VITE_PORTAL_ORIGIN=

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY KALDIRILDI.
# Frontend artık Supabase'e doğrudan gitmiyor ve bundle'da hiçbir Supabase
# anahtarı yok. anon rolünün tablo yetkileri de geri alındı
# (bkz. supabase-portal-auth.sql) — asıl güvenlik kazancı orada.

# META (FACEBOOK / INSTAGRAM) LEAD ADS — yönetim panelindeki "Meta" başvuruları.
# Hepsi SUNUCU TARAFI, VITE_ öneki ALMAZ.
#
# CANLIDA KULLANILAN YOL: Meta -> Google Sheets -> Apps Script -> /api/meta/sheets.
# Anahtarı tablodaki script üretir (scripts/meta-sheets-aktarim.gs,
# `anahtarOlustur`); aynı değer buraya girilir. Tanımlı değilse uç 503 döner
# ve panel "bağlantı kurulmamış" der.
META_SHEETS_KEY=
#
# --- KULLANILMAYAN YOL: kendi Meta uygulamasıyla webhook (/api/meta/webhook) ---
# Kurulumu (sistem kullanıcısı jetonu) zor bulundu; kod duruyor, aşağıdaki
# üçü tanımlı değilken kapalı. Ayrıntılar: server/routes/metaWebhook.ts.
#
# Meta uygulamasının "App Secret"ı (Uygulama ayarları > Temel). Webhook
# imzasını (X-Hub-Signature-256) doğrulamak için.
META_APP_SECRET=
# Webhook kurulurken Meta'ya da yazılan, kendi ürettiğiniz rastgele metin
# (ör. `openssl rand -hex 24`).
META_VERIFY_TOKEN=
# SÜRESİZ sayfa erişim jetonu; leads_retrieval + pages_manage_metadata
# izinleriyle (en sağlamı Business Manager'daki bir sistem kullanıcısından).
META_PAGE_ACCESS_TOKEN=
# İsteğe bağlı: yalnızca bu sayfanın başvurularını al.
META_PAGE_ID=
# İsteğe bağlı, varsayılan v25.0.
META_GRAPH_VERSION=

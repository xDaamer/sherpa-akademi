{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "includeFiles": "need.json"
    }
  },
  "redirects": [
    { "source": "/portal", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "/login", "permanent": true },
    { "source": "/portal/kayit", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "/login", "permanent": true },
    { "source": "/portal/panel", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "https://portal.akademitu.com/", "permanent": true },
    { "source": "/panel", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "https://portal.akademitu.com/", "permanent": true },

    { "source": "/login", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "https://www.akademitu.com/login", "permanent": true },
    { "source": "/panel", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "/", "permanent": true },
    { "source": "/portal", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "/", "permanent": true },
    { "source": "/portal/:path*", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "/", "permanent": true },

    { "source": "/portal", "has": [{ "type": "host", "value": "^(www\\.)?sherpakademi\\.com$" }], "destination": "/login", "permanent": true },
    { "source": "/blog/yazar/akademitu-egitim-ekibi", "destination": "/blog/yazar/sherpa-akademi-egitim-ekibi", "permanent": true },
    { "source": "/portal/kayit", "has": [{ "type": "host", "value": "^(www\\.)?sherpakademi\\.com$" }], "destination": "/login", "permanent": true },
    { "source": "/portal/panel", "has": [{ "type": "host", "value": "^(www\\.)?sherpakademi\\.com$" }], "destination": "https://portal.sherpakademi.com/", "permanent": true },
    { "source": "/panel", "has": [{ "type": "host", "value": "^(www\\.)?sherpakademi\\.com$" }], "destination": "https://portal.sherpakademi.com/", "permanent": true },

    { "source": "/login", "has": [{ "type": "host", "value": "^portal\\.sherpakademi\\.com$" }], "destination": "https://www.sherpakademi.com/login", "permanent": true },
    { "source": "/panel", "has": [{ "type": "host", "value": "^portal\\.sherpakademi\\.com$" }], "destination": "/", "permanent": true },
    { "source": "/portal", "has": [{ "type": "host", "value": "^portal\\.sherpakademi\\.com$" }], "destination": "/", "permanent": true },
    { "source": "/portal/:path*", "has": [{ "type": "host", "value": "^portal\\.sherpakademi\\.com$" }], "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^portal\\.sherpakademi\\.com$" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },

    { "source": "/((?!api/).*)", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "/app.html" },
    { "source": "/((?!api/).*)", "has": [{ "type": "host", "value": "^portal\\.sherpakademi\\.com$" }], "destination": "/app.html" },

    { "source": "/login", "destination": "/app.html" },
    { "source": "/panel", "destination": "/app.html" },
    { "source": "/panel/:path*", "destination": "/app.html" },
    { "source": "/portal", "destination": "/app.html" },
    { "source": "/portal/:path*", "destination": "/app.html" }
  ]
}
